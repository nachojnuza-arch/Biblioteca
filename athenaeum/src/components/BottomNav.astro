---
interface Props {
  activePath: 'library' | 'reader' | 'notebook' | 'settings' | 'admin';
}
const { activePath } = Astro.props;

const items = [
  { path: 'library', href: '/', icon: 'menu_book', label: 'Estantería' },
  { path: 'reader', href: '/lectura', icon: 'bookmark', label: 'Lectura' },
  { path: 'notebook', href: '/cuaderno', icon: 'ink_pen', label: 'Cuaderno' },
  { path: 'settings', href: '/ajustes', icon: 'tune', label: 'Ajustes' }
] as const;
---

<nav
  class="fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.03)]"
  aria-label="Navegación principal"
>
  <div class="flex justify-around items-center h-16 px-space-sm max-w-4xl mx-auto">
    {
      items.map((item) => {
        const isActive = item.path === activePath;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`flex flex-col items-center justify-center min-w-[44px] min-h-[44px] transition-colors ${
              isActive ? 'text-primary font-semibold' : 'text-on-surface-variant hover:text-on-surface'
            }`}
          >
            <span class="material-symbols-outlined text-[22px]" aria-hidden="true">
              {item.icon}
            </span>
            <span class="font-ui text-label-sm mt-0.5">{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
