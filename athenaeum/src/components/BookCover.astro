---
interface Props {
  title: string;
  subtitle?: string;
  author: string;
  palette?: 'terracotta' | 'olive' | 'burgundy' | 'ivory';
  compact?: boolean;
  class?: string;
  coverImage?: string;
  coverFallbackImage?: string;
}

const { title, subtitle = '', author, palette = 'terracotta', compact = false, class: className, coverImage, coverFallbackImage } = Astro.props;

const palettes = {
  terracotta: { bg: '#9E4734', frame: '#FFDAD3', text: '#FFF8F5', accent: '#FFDAD3' },
  olive: { bg: '#384639', frame: '#D7E7D5', text: '#FFF8F5', accent: '#D7E7D5' },
  burgundy: { bg: '#782D20', frame: '#FFDAD4', text: '#FFF8F5', accent: '#FFDAD4' },
  ivory: { bg: '#F4EFE6', frame: '#9E4734', text: '#2B2724', accent: '#9E4734' },
} as const;

const p = palettes[palette];
---

<div class={`relative w-full aspect-[2/3] book-3d-wrapper ${className ?? ''}`} style={`--book-color: ${p.bg};`}>
  
  <!-- Bloque lateral de páginas (derecha) con tapa trasera sutil -->
  <div 
    class="absolute top-0 -right-[12px] h-[calc(100%-1px)] w-[12px] bg-[#f4ebd8] origin-top-left skew-y-[45deg] z-0 overflow-hidden"
    style={`
      background-image: repeating-linear-gradient(to right, transparent, transparent 1px, rgba(216,203,176,0.6) 1px, rgba(216,203,176,0.6) 2px); 
      box-shadow: inset -3px 0 10px rgba(0,0,0,0.05);
      border-right: 1px solid color-mix(in srgb, var(--book-color) 40%, #000);
    `}
  ></div>

  <!-- Bloque inferior de páginas (abajo) con tapa trasera sutil -->
  <div 
    class="absolute -bottom-[12px] left-0 w-[calc(100%-1px)] h-[12px] bg-[#eadeca] origin-top-left skew-x-[45deg] z-0 overflow-hidden shadow-[4px_6px_12px_rgba(43,39,36,0.15)]"
    style={`
      background-image: repeating-linear-gradient(to bottom, transparent, transparent 1px, rgba(216,203,176,0.6) 1px, rgba(216,203,176,0.6) 2px); 
      box-shadow: inset 0 -3px 10px rgba(0,0,0,0.08);
      border-bottom: 1px solid color-mix(in srgb, var(--book-color) 40%, #000);
    `}
  ></div>

  <!-- Pie del lomo (esquina inferior izquierda) más fino (10px) -->
  <div 
    class="absolute -bottom-[12px] left-0 w-[10px] h-[12px] origin-top-left skew-x-[45deg] z-0"
    style={`
      background: linear-gradient(to right, color-mix(in srgb, var(--book-color) 70%, #000), color-mix(in srgb, var(--book-color) 90%, #000));
      border-bottom: 1px solid color-mix(in srgb, var(--book-color) 40%, #000);
      border-left: 1px solid color-mix(in srgb, var(--book-color) 50%, #000);
    `}
  ></div>

  <!-- Portada Frontal (con borde sobresaliente) -->
  <div 
    class="absolute inset-0 rounded-l-[3px] rounded-r-[1px] overflow-hidden flex flex-col items-center justify-between p-4 text-center z-10 bg-surface"
    style={`
      background: linear-gradient(160deg, var(--book-color) 0%, color-mix(in srgb, var(--book-color) 85%, #000) 100%); 
      color: ${p.text}; 
      box-shadow: inset 4px 0 8px -2px rgba(0,0,0,0.4);
      border-right: 1.5px solid color-mix(in srgb, var(--book-color) 70%, #fff);
      border-bottom: 1.5px solid color-mix(in srgb, var(--book-color) 50%, #000);
    `}
    role="img"
    aria-label={`Portada de ${title}, de ${author}`}
  >
    {coverImage && (
      <img
        data-cover-src={coverImage}
        data-cover-fallback-src={coverFallbackImage}
        alt={`Portada de ${title}`}
        crossorigin="anonymous"
        class="ngrok-cover absolute inset-0 w-full h-full object-cover z-20 transition-opacity duration-300 opacity-0"
      />
    )}
    
    <!-- Grano y doble filo editorial -->
    <div class="absolute inset-0 paper-grain pointer-events-none z-25" style="opacity: 0.08;"></div>
    
    <!-- Lomo falso frontal (hendidura) -->
    <div
      class="absolute inset-y-0 left-0 w-[5%] pointer-events-none z-30"
      style={`background: linear-gradient(to right, rgba(255,255,255,0.15), rgba(0,0,0,0.2) 50%, rgba(255,255,255,0.05) 80%, transparent);`}
    >
    </div>

    <!-- Borde interior para simular el cartón de la tapa -->
    <div class="absolute inset-0 border-[2px] pointer-events-none z-30 opacity-40 mix-blend-overlay" style={`border-color: var(--book-color);`}></div>

    <!-- Contenido CSS cuando no hay imagen -->
    <div class="relative z-1 pt-2 flex flex-col items-center gap-1">
      <span class="font-ui text-[9px] uppercase tracking-[0.28em]" style={`color: ${p.frame};`}>
        Athenaeum
      </span>
      <span class="material-symbols-outlined text-[14px]" style={`color: ${p.frame};`} aria-hidden="true">
        auto_stories
      </span>
    </div>

    <div class="relative z-1 flex flex-col items-center gap-2 px-2">
      <h3 class={`font-reading font-medium leading-tight tracking-tight drop-shadow-md ${compact ? 'text-[15px]' : 'text-[19px]'}`}>
        {title}
      </h3>
      <span class="w-8 h-px" style={`background: color-mix(in srgb, ${p.frame} 60%, transparent);`}></span>
      {subtitle && (
        <span class={`font-ui text-[9px] uppercase tracking-[0.14em] drop-shadow-sm ${compact ? 'line-clamp-1' : 'line-clamp-2'}`} style={`color: color-mix(in srgb, ${p.text} 82%, transparent);`}>
          {subtitle}
        </span>
      )}
    </div>

    <div class="relative z-1 pb-2">
      <span class="font-ui text-[9px] uppercase tracking-[0.22em] drop-shadow-sm" style={`color: ${p.frame};`}>
        {author}
      </span>
    </div>
  </div>
</div>

<script>
  function getAverageColor(imgElement) {
    try {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      canvas.width = 1;
      canvas.height = 1;
      ctx.drawImage(imgElement, 0, 0, 1, 1);
      const data = ctx.getImageData(0, 0, 1, 1).data;
      if (data[3] === 0) return null; // Transparente
      return `rgb(${data[0]}, ${data[1]}, ${data[2]})`;
    } catch (e) {
      return null;
    }
  }

  function loadCovers() {
    const covers = document.querySelectorAll('img.ngrok-cover');
    covers.forEach((img) => {
      const src = img.getAttribute('data-cover-src');
      const fallbackSrc = img.getAttribute('data-cover-fallback-src');
      if (!src) return;

      const fetchImage = (url) => {
        return fetch(url, { headers: { 'ngrok-skip-browser-warning': 'true' } })
          .then(res => {
            if (!res.ok) throw new Error('Not found');
            return res.blob();
          });
      };

      fetchImage(src)
        .catch(() => {
           if (fallbackSrc) {
              return fetchImage(fallbackSrc);
           }
           throw new Error('No fallback');
        })
        .then((blob) => {
          const url = URL.createObjectURL(blob);
          
          img.onload = () => {
            const domColor = getAverageColor(img);
            if (domColor) {
              const wrapper = img.closest('.book-3d-wrapper');
              if (wrapper) {
                // @ts-ignore
                wrapper.style.setProperty('--book-color', domColor);
              }
            }
            // @ts-ignore
            img.style.opacity = '1';
          };
          
          // @ts-ignore
          img.src = url;
        })
        .catch(() => {
          img.remove();
        });
    });
  }

  loadCovers();
  document.addEventListener('astro:page-load', loadCovers);
</script>
