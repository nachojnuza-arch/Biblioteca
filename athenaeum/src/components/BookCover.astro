---
/**
 * Portada tipográfica generada con CSS (sin imágenes).
 * Simula una chaqueta de libro: título, subtítulo, sello editorial y autor,
 * con lomo a la izquierda (radio asimétrico del design system).
 */
interface Props {
  title: string;
  subtitle?: string;
  author: string;
  palette?: 'terracotta' | 'olive' | 'burgundy' | 'ivory';
  /** Tamaño relativo del texto del título */
  compact?: boolean;
  class?: string;
  coverImage?: string;
}

const { title, subtitle = '', author, palette = 'terracotta', compact = false, class: className, coverImage } = Astro.props;

const palettes = {
  terracotta: { bg: '#9E4734', frame: '#FFDAD3', text: '#FFF8F5', accent: '#FFDAD3' },
  olive: { bg: '#384639', frame: '#D7E7D5', text: '#FFF8F5', accent: '#D7E7D5' },
  burgundy: { bg: '#782D20', frame: '#FFDAD4', text: '#FFF8F5', accent: '#FFDAD4' },
  ivory: { bg: '#F4EFE6', frame: '#9E4734', text: '#2B2724', accent: '#9E4734' },
} as const;

const p = palettes[palette];
---

<div class={`group relative [perspective:1200px] w-full ${className ?? ''}`}>
  <!-- Contenedor 3D del libro -->
  <div 
    class="relative w-full aspect-[2/3] transition-all duration-500 ease-out origin-left [transform-style:preserve-3d] group-hover:[transform:rotateY(-20deg)_rotateX(4deg)_scale(1.02)] rounded-l-sm rounded-r-lg group-hover:shadow-[20px_20px_25px_-5px_rgba(0,0,0,0.15)]"
    style={`box-shadow: inset 3px 0 6px -2px rgba(28,25,23,0.35), 4px 6px 12px rgba(43,39,36,0.1);`}
  >
    
    <!-- Lomo (visible al girar) -->
    <div 
      class="absolute top-0 bottom-0 left-0 w-[18px] origin-right [transform:translateX(-100%)_rotateY(-90deg)] rounded-l-[3px] shadow-inner"
      style={`background: linear-gradient(to right, color-mix(in srgb, ${p.bg} 80%, #000), ${p.bg});`}
    >
       <div class="w-full h-full opacity-10 paper-grain pointer-events-none"></div>
    </div>

    <!-- Páginas (borde derecho, visibles al girar) -->
    <div 
      class="absolute top-[1.5%] bottom-[1.5%] right-0 w-[24px] origin-left [transform:translateX(100%)_rotateY(90deg)] bg-[#f4ebd8] border-y border-r border-[#e3d5b9]/50 overflow-hidden rounded-r-[3px]"
      style="background-image: repeating-linear-gradient(to bottom, transparent, transparent 1px, rgba(227,213,185,0.4) 1px, rgba(227,213,185,0.4) 2px); box-shadow: inset 4px 0 10px rgba(0,0,0,0.1);"
    >
    </div>

    <!-- Páginas (borde inferior) -->
    <div 
      class="absolute bottom-0 left-[1.5%] right-[1.5%] h-[24px] origin-top [transform:translateY(100%)_rotateX(-90deg)] bg-[#f4ebd8] border-x border-b border-[#e3d5b9]/50 overflow-hidden rounded-b-[3px]"
      style="background-image: repeating-linear-gradient(to right, transparent, transparent 1px, rgba(227,213,185,0.4) 1px, rgba(227,213,185,0.4) 2px); box-shadow: inset 0 4px 10px rgba(0,0,0,0.1);"
    >
    </div>

    <!-- Portada Frontal -->
    <div 
      class="absolute inset-0 rounded-l-sm rounded-r-lg overflow-hidden flex flex-col items-center justify-between p-4 text-center [backface-visibility:hidden] [transform:translateZ(1px)] bg-surface"
      style={`background: linear-gradient(160deg, ${p.bg} 0%, color-mix(in srgb, ${p.bg} 85%, #000) 100%); color: ${p.text};`}
      role="img"
      aria-label={`Portada de ${title}, de ${author}`}
    >
      {coverImage && (
        <img
          data-cover-src={coverImage}
          alt={`Portada de ${title}`}
          class="ngrok-cover absolute inset-0 w-full h-full object-cover z-20 transition-opacity duration-300 opacity-0"
        />
      )}
      
      <!-- Grano y doble filo editorial -->
      <div class="absolute inset-0 paper-grain pointer-events-none" style="opacity: 0.08; z-index: 25;"></div>
      
      <!-- Lomo falso para sombra frontal -->
      <div
        class="absolute inset-y-0 left-0 w-[5%] pointer-events-none z-30"
        style={`background: linear-gradient(to right, rgba(255,255,255,0.1), rgba(0,0,0,0.2) 30%, transparent);`}
      >
      </div>

      <!-- Diseño CSS cuando no hay imagen -->
      <div class="relative z-1 pt-2 flex flex-col items-center gap-1">
        <span class="font-ui text-[9px] uppercase tracking-[0.28em]" style={`color: ${p.frame};`}>
          Athenaeum Archival
        </span>
        <span class="material-symbols-outlined text-[14px]" style={`color: ${p.frame};`} aria-hidden="true">
          auto_stories
        </span>
      </div>

      <div class="relative z-1 flex flex-col items-center gap-2 px-2">
        <h3 class={`font-reading font-medium leading-tight tracking-tight ${compact ? 'text-[15px]' : 'text-[19px]'}`}>
          {title}
        </h3>
        <span class="w-8 h-px" style={`background: color-mix(in srgb, ${p.frame} 60%, transparent);`}></span>
        {subtitle && (
          <span class={`font-ui text-[9px] uppercase tracking-[0.14em] ${compact ? 'line-clamp-1' : 'line-clamp-2'}`} style={`color: color-mix(in srgb, ${p.text} 82%, transparent);`}>
            {subtitle}
          </span>
        )}
      </div>

      <div class="relative z-1 pb-2">
        <span class="font-ui text-[9px] uppercase tracking-[0.22em]" style={`color: ${p.frame};`}>
          {author}
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  function loadCovers() {
    const covers = document.querySelectorAll('img.ngrok-cover');
    covers.forEach((img) => {
      const src = img.getAttribute('data-cover-src');
      if (!src) return;

      fetch(src, {
        headers: {
          'ngrok-skip-browser-warning': 'true'
        }
      })
        .then((res) => {
          if (!res.ok) throw new Error('Cover not found');
          return res.blob();
        })
        .then((blob) => {
          img.src = URL.createObjectURL(blob);
          // @ts-ignore
          img.style.opacity = '1';
        })
        .catch(() => {
          img.remove();
        });
    });
  }

  loadCovers();
  document.addEventListener('astro:page-load', loadCovers);
</script>
